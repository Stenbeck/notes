BASE_URL=
AUTH_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS

# Use a dedicated database and URL-encode credentials in the URI.
# Set the TLS CA file and server name if your MongoDB connection requires them.
MONGODB_URI=
MONGODB_TLS_CA_FILE=
MONGODB_TLS_SERVER_NAME=

NOTES_DATA_DIR=./data

# Maximum size per attachment in MiB; defaults to 10 when unset.
MAX_FILE_SIZE_MB=10

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

STORAGE_DRIVER=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

NOTES_MAINTENANCE=false
